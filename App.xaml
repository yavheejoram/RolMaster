<Application x:Class="RolMaster.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml"><Application.Resources>
<SolidColorBrush x:Key="Bg" Color="#17171C"/><SolidColorBrush x:Key="Panel" Color="#24242D"/><SolidColorBrush x:Key="Bronze" Color="#D1A76D"/>
<Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Bg}"/><Setter Property="Foreground" Value="#F0E6D8"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#43352F"/><Setter Property="Foreground" Value="#F6E5D0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="BorderBrush" Value="#8A6948"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#30303A"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="#24242D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style>
</Application.Resources></Application>
